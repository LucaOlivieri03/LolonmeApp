# Supabase PostgreSQL & Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical public origin used for Supabase Auth Magic Link callbacks (e.g. https://lolonmeapp.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret key required for CLI seeding (`npm run db:seed`) and privileged admin jobs
SUPABASE_SERVICE_ROLE_KEY=
